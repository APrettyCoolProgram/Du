<Window x:Class="Du.DuDownload"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Du"
        Title="File Download"
        Width="450"
        Height="114"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        mc:Ignorable="d">
    <Grid>
        <Rectangle
            x:Name="Container"
            Height="94"
            Margin="10"
            Fill="#FFB3D9FF"
            Stroke="Black" />
        <Label
            x:Name="DownloadMessage"
            Width="391"
            Margin="19,13,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Content="Message"
            FontFamily="Arial"
            FontSize="18" />
        <ProgressBar
            x:Name="DownloadProgress"
            Width="413"
            Height="20"
            Margin="19,49,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top" />
        <Label
            x:Name="WindowCloseMessage"
            Margin="23,75,22,16"
            HorizontalContentAlignment="Center"
            Content="[ This window will automatically close when the download is complete ]"
            FontFamily="Arial" />
    </Grid>
</Window>
