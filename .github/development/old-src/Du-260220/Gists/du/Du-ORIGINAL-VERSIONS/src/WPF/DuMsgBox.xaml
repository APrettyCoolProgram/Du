<!--
    This isn't being currently developed, but I'm leaving it since it probably will have a use at some point.
-->

<Window x:Class="Du.MsgBox"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:Du"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        Title="MsgBox"
        Width="600"
        Height="250"
        WindowStartupLocation="CenterScreen"
        mc:Ignorable="d">
    <Grid>
        <WrapPanel>
            <Label x:Name="lblMsgTitle"
                   Width="580"
                   Margin="10,10,0,0"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Top"
                   Content="lblMsgTitle"
                   FontSize="20"
                   FontWeight="Bold" />
            <Label x:Name="lblMsgBody"
                   Width="580"
                   Height="100"
                   Margin="10,10,0,0"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Top"
                   Content="lblMsgBody"
                   FontSize="14" />
            <Button x:Name="btnBoxButton1"
                    Width="100"
                    Height="25"
                    Margin="5,5"
                    HorizontalAlignment="right"
                    VerticalAlignment="Top"
                    Click="btnBoxButton1_Click"
                    Content="01" />
            <Button x:Name="btnBoxButton2"
                    Width="100"
                    Height="25"
                    Margin="5,5"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Click="btnBoxButton2_Click"
                    Content="02" />
            <Button x:Name="btnBoxButton3"
                    Width="100"
                    Height="25"
                    Margin="5,5"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Click="btnBoxButton3_Click"
                    Content="03" />
        </WrapPanel>
    </Grid>
</Window>
