<Window
    x:Class="Du.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Du"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="MainWindow"
    Width="1600"
    Height="700"
    mc:Ignorable="d">
    <Grid>
        <TabControl
            x:Name="tabctrlExamples"
            Width="902"
            Height="335"
            Margin="10,36,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top">
            <TabItem x:Name="tabctrlDuArrayExamples" Header="TabItem">
                <Grid Background="#FFE5E5E5">
                    <Label
                        x:Name="ExampleArray"
                        Width="151"
                        Margin="10,10,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Content="ExampleArray" />
                    <TextBlock
                        x:Name="tblkExampleArray"
                        Width="103"
                        Height="252"
                        Margin="10,41,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Text=""
                        TextWrapping="Wrap" />
                </Grid>
            </TabItem>
            <TabItem Header="TabItem">
                <Grid Background="#FFE5E5E5" />
            </TabItem>
        </TabControl>
    </Grid>
</Window>
